<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MacKeys</RootNamespace>
    <AssemblyName>MacKeys</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <Product>MacKeys</Product>
    <Description>macOS keyboard shortcuts on Windows</Description>
    <Version>1.0.0</Version>
    <Company>digitaltyp</Company>
    <Authors>digitaltyp</Authors>
    <Copyright>© 2026 digitaltyp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/digitaltyp0/MacKeys</RepositoryUrl>
  </PropertyGroup>

  <!-- Keep local folder paths out of release binaries. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MacKeys.Tests" />
  </ItemGroup>

</Project>
